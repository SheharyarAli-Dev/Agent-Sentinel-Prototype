# ─── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/risk_gatekeeper.db

# ─── Risk Thresholds ───────────────────────────────────────────────────────────
# Maximum transaction amount (USD) before human approval is required
TRANSACTION_LIMIT_USD=50.0

# Jaccard similarity threshold below which intent drift is flagged (Module 6)
INTENT_DRIFT_THRESHOLD=0.15

# Maximum number of plan steps before scope is considered too broad (Module 7)
PLAN_SCOPE_THRESHOLD=10

# Maximum number of distinct files a plan may touch before a scope warning
PLAN_FILE_SCOPE_THRESHOLD=20

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
